# Required at build time. import.meta.env.VITE_* values are inlined by Vite
# when the bundle compiles — missing, and every image URL ships as
# res.cloudinary.com/undefined/... and the site renders blank. scripts/
# check-build-env.mjs refuses to build without it. Set it locally, in the
# Vercel project's Environment Variables, and in .github/workflows/ci.yml.
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Public URL of the real application that "Get Started" / "Sign In" /
# "Join a Community" buttons redirect to. Safe to skip — falls back to
# https://app.glasspay.app.
# VITE_APP_URL=https://app.glasspay.app

# Optional. Enables crash/error reporting (src/utils/monitoring.js) via
# Sentry. Leave unset to run with monitoring disabled (the current default,
# including production, until a Sentry project is set up for this site).
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Upload-script-only credentials (scripts/upload-assets-to-cloudinary.mjs).
# Server-side values, never shipped to the browser; keep them in .env (which
# is gitignored), not committed.
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret